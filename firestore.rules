rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Common global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Products Rules
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    // Categories Rules
    match /categories/{categoryId} {
      allow read, write: if isSignedIn();
    }

    // Customers Rules
    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    // Transactions Rules
    match /transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    // DebtLogs Rules
    match /debtLogs/{debtLogId} {
      allow read, write: if isSignedIn();
    }

    // StockLogs Rules
    match /stockLogs/{stockLogId} {
      allow read, write: if isSignedIn();
    }

    // Users Rules and subcollections
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Settings Rules
    match /settings/store {
      allow read, write: if isSignedIn();
    }

    // Developer Remote Stores Registry Rules (For tracking store instances on published link)
    match /developer_remote_stores/{storeId} {
      allow read, write: if true;
    }

    // Test Connection Rule for health check
    match /test/{testId} {
      allow read: if true;
    }
  }
}
